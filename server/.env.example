PORT=5000
NODE_ENV=development

# --- AI provider -------------------------------------------------------------
# OpenAI: set your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Any OpenAI-compatible server instead (no key needed for local ones), e.g. Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b

# AI_PROVIDER=openai
# AI_TIMEOUT_MS=120000

# --- Security ------------------------------------------------------------------
# Use a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_secret

# Extra browser origins allowed to call the API (comma-separated). Not needed when
# the client is served by this server.
CORS_ORIGIN=
# TRUST_PROXY=1   # set when running behind a reverse proxy

# Rate limits (defaults shown)
# API_RATE_LIMIT=600              # requests per IP per 15 minutes
# AUTH_RATE_LIMIT=30              # login/register attempts per IP per 15 minutes
# AI_RATE_LIMIT_PER_MINUTE=20     # AI requests per user per minute

# --- Storage ---------------------------------------------------------------------
# PostgreSQL (recommended). Leave empty to use a local JSON file instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduai
# EDUAI_DATA_FILE=./data/eduai-data.json
